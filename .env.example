# Copy to .env and adjust. Never commit .env.

# Postgres connection string (production + normal dev — e.g. Neon/Vercel
# Postgres/Supabase). For fully-offline dev see the note at the top of
# prisma/schema.prisma (temporary sqlite flip).
DATABASE_URL="postgresql://user:password@host:5432/twinoaks"

# Owner login password. REQUIRED in production — the app redirects every
# route to /login when set. Unset = gate disabled (local dev only).
APP_PASSWORD=""

# Vercel Blob token for receipt/document storage (set automatically when a
# Blob store is connected to the Vercel project). Unset = files stored on
# local disk under UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=""

# Local-disk upload location used only when BLOB_READ_WRITE_TOKEN is unset.
UPLOAD_DIR="var/uploads"

# ---- Email-forwarded receipts (optional) ----
# Shared secret for the inbound-email webhook. When unset the endpoint is
# disabled. Point your inbound-email provider (CloudMailin, Postmark,
# SendGrid Inbound Parse, Mailgun…) at:
#   https://<your-app>/api/inbound/email/<INBOUND_EMAIL_SECRET>
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INBOUND_EMAIL_SECRET=""

# The address the provider gave you — shown on Settings → Email receipts so
# you know where to forward. Display only; it does not affect routing.
INBOUND_EMAIL_ADDRESS=""

# Comma-separated sender allowlist. Recommended: your own email address(es).
# When unset, mail from ANY sender that reaches the address is accepted.
INBOUND_ALLOWED_SENDERS=""

# ---- AI receipt reading (optional) ----
# Anthropic API key. Turns on automatic reading of receipt PHOTOS and scanned
# PDFs (vendor/date/total/tax pre-fill on Add receipt). PDFs with a real text
# layer are read for free without this. Get a key at console.anthropic.com —
# each scan costs a fraction of a cent (claude-haiku-4-5, ~400 tokens).
ANTHROPIC_API_KEY=""

# ---- Automatic daily backups (optional but recommended) ----
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` on scheduled
# runs of /api/cron/backup (see vercel.json). Without it, automatic backups
# refuse to run rather than leaving an open database-dump trigger.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""
