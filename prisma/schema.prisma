// Twin Oaks OS — V1 data model (financial core + equipment).
//
// Production target is Postgres (Vercel deployment). Money is stored as
// integer cents, and enum-like fields are strings whose allowed values live
// in src/lib/domain.ts — keep that file the source of truth.
//
// Offline-only local dev without any Postgres: flip provider to "sqlite",
// set DATABASE_URL="file:./dev.db", run `pnpm db:push && pnpm db:seed`
// (the schema is written to work on both), and don't commit the flip.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-user (2026-08): every business using this deployment is an Account.
// The original Twin Oaks books live under the fixed id "owner", which is
// what the legacy APP_PASSWORD login resolves to. Data tables carry a plain
// `accountId` column (no relation on purpose — keeps the sweep mechanical
// and the queries explicit; a missed filter fails loudly in review, not
// silently across tenants).
model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // scrypt hash ("s1$salt$hash"); empty string = env-password-only account
  // (the owner), which the email login always refuses.
  passwordHash String
  createdAt    DateTime @default(now())
}

model Vendor {
  id        String    @id @default(cuid())
  accountId String
  name      String
  notes     String?
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@unique([accountId, name])
  @@index([accountId])
}

// A receipt is first-class: it can exist before it is categorized (the Inbox),
// and it permanently stores the original image/PDF once attached.
model Receipt {
  id            String    @id @default(cuid())
  accountId     String
  status        String    @default("INBOX") // see RECEIPT_STATUSES in src/lib/domain.ts
  // UPLOAD (camera/file picker) | EMAIL (forwarded to the inbound address)
  source        String    @default("UPLOAD")
  emailFrom     String?
  emailSubject  String?
  filePath      String? // storage key under UPLOAD_DIR; null = record without a file yet
  fileName      String?
  mimeType      String?
  fileSize      Int?
  vendorName    String?
  receiptDate   DateTime?
  totalCents    Int?
  salesTaxCents Int?
  paymentMethod String?
  receiptNumber String?
  notes         String?
  expenseId     String?
  expense       Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  lines         ReceiptLine[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([expenseId])
  @@index([accountId])
}

model Expense {
  id                 String              @id @default(cuid())
  accountId          String
  date               DateTime
  vendorId           String?
  vendor             Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorName         String? // denormalized for fast entry + search
  description        String
  amountCents        Int
  salesTaxCents      Int?
  paymentMethod      String?
  division           String // FARM | TECH | SHARED — see DIVISIONS
  accountingCategory String // bookkeeping/tax category — see ACCOUNTING_CATEGORIES
  managementCategory String? // free-form drill-down path, e.g. "Farm Equipment > Tractor #1 > Hydraulic system"
  businessPurpose    String?
  assetId            String?
  asset              Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  // V3: costs can be attributed to one animal, which is what makes
  // cost-per-head and cost-per-lamb-weaned computable.
  animalId           String?
  animal             Animal?             @relation(fields: [animalId], references: [id], onDelete: SetNull)
  taxYear            Int
  // Tax-safety principle: the app NEVER assumes deductibility. New expenses
  // default to NEEDS_REVIEW until a human classifies them.
  taxStatus          String              @default("NEEDS_REVIEW") // see TAX_STATUSES
  isCapital          Boolean             @default(false) // flagged major purchase (depreciation / §179 review)
  notes              String?
  receipts           Receipt[]
  maintenanceRecords MaintenanceRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([date])
  @@index([taxYear, division])
  @@index([accountingCategory])
  @@index([taxStatus])
  @@index([assetId])
  @@index([accountId])
}

model Income {
  id            String   @id @default(cuid())
  accountId     String
  date          DateTime
  source        String? // customer/buyer name (free-form until Customers arrive in V2)
  description   String
  amountCents   Int
  division      String // FARM | TECH | SHARED
  category      String // see INCOME_CATEGORIES
  paymentMethod String?
  notes         String?
  taxYear       Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([taxYear, division])
  @@index([accountId])
}

// Equipment / capital asset profile: tractors, printers, trailers, buildings…
model Asset {
  id                 String              @id @default(cuid())
  accountId          String
  name               String // "Tractor #1", "Bambu H2D #1"
  assetTag           String? // internal asset ID
  kind               String // see ASSET_KINDS
  division           String // FARM | TECH | SHARED
  manufacturer       String?
  model              String?
  serialNumber       String?
  year               Int?
  purchaseDate       DateTime?
  purchasePriceCents Int?
  purchasedFrom      String?
  financingNotes     String?
  warrantyNotes      String?
  currentHours       Float? // engine hours (tractors, printers use print-hours)
  currentMileage     Float? // vehicles/trailers
  status             String              @default("ACTIVE") // ACTIVE | SOLD | RETIRED
  notes              String?
  expenses           Expense[]
  maintenance        MaintenanceRecord[]
  mileageLogs        MileageLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([kind])
  @@index([division])
  @@index([accountId])
}

// Receipt/document originals stored IN the database. This is the automatic
// fallback when no Blob store is connected to the deployment (the Vercel
// filesystem is read-only, so without it there'd be no file storage at all —
// the 2026-08 "File storage isn't connected" incident). Storage keys look
// like "db:<id>"; intake is capped by the API route (~4.5 MB on Vercel).
// When a Blob store IS connected, new files go there instead.
model StoredFile {
  id        String   @id @default(cuid())
  accountId String
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([accountId])
}

// ————— Household (personal) money — deliberately SEPARATE tables —————
// Personal spending must never touch the business books: it stays out of
// the Tax Center, business exports, and expense reports by construction
// (its own tables), not by filter discipline.

model HouseholdExpense {
  id            String   @id @default(cuid())
  accountId     String
  date          DateTime
  description   String?
  amountCents   Int
  // EXPENSE | INCOME — one table so a month's summary is one query. Income
  // categories live in HOUSEHOLD_INCOME_CATEGORIES.
  kind          String   @default("EXPENSE")
  category      String // see HOUSEHOLD_CATEGORIES in src/lib/domain.ts
  paymentMethod String?
  notes         String?
  // Set when this row was posted automatically from a repeating item.
  recurringId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId, date])
  @@index([recurringId])
}

// One monthly target per category; spending is compared against it.
model HouseholdBudget {
  id           String @id @default(cuid())
  accountId    String
  category     String
  monthlyCents Int

  @@unique([accountId, category])
}

// Bills and paychecks that post themselves: rent on the 1st, the streaming
// bundle on the 12th. Materialized into HouseholdExpense rows (stamped with
// recurringId) the first time the month is opened — idempotent, so a month
// can be viewed a hundred times and each item posts exactly once.
model RecurringHousehold {
  id          String   @id @default(cuid())
  accountId   String
  kind        String   @default("EXPENSE") // EXPENSE | INCOME
  description String
  amountCents Int
  category    String
  dayOfMonth  Int      @default(1) // 1–28 so it exists in every month
  createdAt   DateTime @default(now())

  @@index([accountId])
}

// FR-007: entered once in Settings, reused on every customer-facing
// document. Single row (id is always "singleton").
model BusinessProfile {
  id                    String   @id @default(cuid())
  // One profile per account. The pre-multi-user row keeps its historical
  // id "singleton" and belongs to the owner account.
  accountId             String   @unique
  // Comma-separated division set for this business. Null = the legacy
  // FARM,TECH,SHARED trio (the owner); new accounts get "GENERAL", which
  // hides the division picker across the app.
  divisionsCsv          String?
  // Extra expense categories this household added ("Homeschool,Horses").
  // Appended to the built-in HOUSEHOLD_CATEGORIES everywhere.
  householdCategoriesCsv String?
  name                  String   @default("Twin Oaks Farm & Tech")
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  postalCode            String?
  phone                 String?
  email                 String?
  website               String?
  logoPath              String? // storage key, same pipeline as receipts
  // BUG-001: the house sales-tax rate new invoices start from.
  defaultTaxRatePercent Float    @default(0)
  updatedAt             DateTime @updatedAt
}

// FR-004: issues and ideas found while using the app, numbered per kind
// (BUG-001, FR-002, UI-003, TAX-004).
model Ticket {
  id             String   @id @default(cuid())
  accountId      String
  ref            String // "BUG-001" — unique per account
  kind           String // BUG | FR | UI | TAX
  number         Int
  title          String
  description    String?
  priority       String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status         String   @default("NEW") // NEW | WORKING | READY_FOR_TESTING | TESTING | COMPLETE
  devNotes       String?
  attachmentPath String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([accountId, ref])
  @@index([kind, number])
  @@index([status])
  @@index([accountId])
}

// Face ID / Touch ID sign-in (SPEC §32). A passkey is an ADDITIVE second
// way in — the owner password always keeps working, so a lost or wiped
// device can never lock the owner out of their own books.
model Passkey {
  id           String   @id @default(cuid())
  accountId    String
  credentialId String   @unique // base64url (globally unique by WebAuthn design)
  publicKey    String // base64url COSE key
  counter      Int      @default(0)
  transports   String? // comma-separated hints from the authenticator
  label        String // "Greg's iPhone"
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([accountId])
}

// ————— V2: the revenue loop (SPEC §§14–17) + mileage (§19) —————

model Customer {
  id        String    @id @default(cuid())
  accountId String
  name      String
  company   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  // BUG-001 follow-up: tax rules ride on the customer, so the right rate
  // fills itself in every time you invoice them.
  //   DEFAULT — use the Business profile's rate
  //   RATE    — this customer's own rate (their city/county)
  //   EXEMPT  — no tax (resale certificate, farm exemption, no nexus…)
  taxTreatment    String   @default("DEFAULT")
  taxRatePercent  Float?
  taxExemptReason String?
  invoices  Invoice[]
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([accountId])
}

model Invoice {
  id            String        @id @default(cuid())
  accountId     String
  number        String // "INV-001" / "Q-001" — unique per account
  // QUOTE | INVOICE — quotes share the whole machinery (lines, print view)
  // but take no payments; converting a quote creates a fresh invoice and
  // stamps convertedToInvoiceId here (derived status: ACCEPTED).
  kind          String        @default("INVOICE")
  convertedToInvoiceId String?
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  division      String // FARM | TECH | SHARED
  // Stored base status: DRAFT | SENT | CANCELLED. Paid/partially-paid/overdue
  // are DERIVED from payments + dueDate — never stored, never drifts.
  status        String        @default("DRAFT")
  issueDate     DateTime
  dueDate       DateTime?
  terms         String?
  notes         String?
  subtotalCents Int           @default(0)
  salesTaxCents Int           @default(0)
  totalCents    Int           @default(0)
  // BUG-001: the rate actually applied, stored with the transaction so a
  // later rate change never rewrites history. Null = no tax applied.
  taxRatePercent    Float?
  // True when the operator typed a tax amount by hand instead of letting
  // the rate drive it (odd jurisdictions, rounding to match a paper form).
  taxManualOverride Boolean   @default(false)
  // FR-007: business details frozen onto the document when it is finalized,
  // so editing Settings later cannot alter an already-issued invoice.
  businessSnapshot  String?
  shipToAddress     String?
  taxYear       Int
  lines         InvoiceLine[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([accountId, number])
  @@index([customerId])
  @@index([status])
  @@index([taxYear])
  @@index([accountId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder      Int     @default(0)
  description    String
  quantity       Float   @default(1)
  unitPriceCents Int
  totalCents     Int
  // BUG-001: labor/services/freight are often exempt — tax is summed over
  // taxable lines only.
  taxable        Boolean @default(true)
}

model Payment {
  id          String    @id @default(cuid())
  accountId   String
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date        DateTime
  amountCents Int
  method      String?
  checkNumber String?
  notes       String?
  incomeId    String? // the auto-created Income row that puts this payment on the books
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([invoiceId])
  @@index([accountId])
}

// Mileage (SPEC §19). Tax-safety: we record miles; the deduction rate and
// treatment are the accountant's call.
model MileageLog {
  id             String   @id @default(cuid())
  accountId      String
  date           DateTime
  startLocation  String?
  destination    String
  purpose        String
  customerName   String?
  vehicleAssetId String?
  vehicle        Asset?   @relation(fields: [vehicleAssetId], references: [id], onDelete: SetNull)
  startOdometer  Float?
  endOdometer    Float?
  miles          Float
  notes          String?
  taxYear        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([taxYear])
  @@index([accountId])
}

model MaintenanceRecord {
  id             String   @id @default(cuid())
  accountId      String
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date           DateTime
  hoursAtService Float?
  category       String // see MAINTENANCE_CATEGORIES
  description    String
  partsCostCents Int?
  laborCostCents Int?
  vendorName     String?
  notes          String?
  expenseId      String?
  expense        Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([assetId, date])
  @@index([accountId])
}

// ———————————————————————————————————————————————————————————————————————
// V3 — Farm / livestock (SPEC §§22–24)
// ———————————————————————————————————————————————————————————————————————

// One animal. The owner's handle is the ear tag, so that is what must be
// unique per account — names are optional and often absent.
model Animal {
  id                   String        @id @default(cuid())
  accountId            String
  tagNumber            String // ear tag — the owner's primary handle
  name                 String?
  species              String        @default("Sheep") // see ANIMAL_SPECIES
  breed                String?
  sex                  String // EWE | RAM | WETHER — see ANIMAL_SEXES
  birthDate            DateTime?
  birthType            String? // SINGLE | TWIN | TRIPLET | QUAD
  sireId               String?
  sire                 Animal?       @relation("AnimalSire", fields: [sireId], references: [id], onDelete: SetNull)
  siredOffspring       Animal[]      @relation("AnimalSire")
  damId                String?
  dam                  Animal?       @relation("AnimalDam", fields: [damId], references: [id], onDelete: SetNull)
  bornOffspring        Animal[]      @relation("AnimalDam")
  // ACTIVE | SOLD | DECEASED | TRANSFERRED — see ANIMAL_STATUSES
  status               String        @default("ACTIVE")
  acquisitionDate      DateTime?
  acquisitionCostCents Int?
  currentWeightLbs     Float?
  photoPath            String?
  notes                String?
  events               AnimalEvent[]
  expenses             Expense[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([accountId, tagNumber])
  @@index([accountId])
  @@index([accountId, status])
}

// Every event in SPEC §23 rides one table — a shepherd logging a vaccination
// and a lambing should not meet two different screens. Type-specific fields
// are optional columns; the form shows only the ones the chosen kind uses.
model AnimalEvent {
  id              String    @id @default(cuid())
  accountId       String
  animalId        String
  animal          Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  date            DateTime
  kind            String // see ANIMAL_EVENT_KINDS
  description     String?
  weightLbs       Float? // WEIGHT
  productName     String? // VACCINATION | MEDICATION | DEWORMING — what was given
  dosage          String?
  // Meat/milk withdrawal — a real legal date, not a nicety.
  withdrawalUntil DateTime?
  mateAnimalId    String? // BREEDING — the ram used
  dueDate         DateTime? // BREEDING — expected lambing
  result          String? // PREGNANCY_CHECK: BRED | OPEN | UNSURE
  lambCount       Int? // LAMBING
  costCents       Int?
  expenseId       String? // the Expense row this event cost, when it cost money
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accountId, date])
  @@index([animalId, date])
  @@index([accountId, kind])
}

// A sale of an animal. Posts a linked Income row the same way Payment does,
// so the books need no double entry.
model LivestockSale {
  id              String    @id @default(cuid())
  accountId       String
  animalId        String?
  customerId      String?
  buyerName       String?
  date            DateTime
  salePriceCents  Int
  weightLbs       Float?
  paymentMethod   String?
  incomeId        String? // auto-created Income row
  processingNotes String?
  notes           String?
  taxYear         Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accountId, date])
  @@index([animalId])
  @@index([accountId, taxYear])
}

// ———————————————————————————————————————————————————————————————————————
// V4 — Manufacturing / 3D printing (SPEC §§12–13, 15)
// Printers are Assets already — this extends them, it does not duplicate.
// ———————————————————————————————————————————————————————————————————————

model FilamentSpool {
  id                 String        @id @default(cuid())
  accountId          String
  manufacturer       String?
  material           String // see FILAMENT_MATERIALS
  colorName          String?
  spoolTag           String? // the owner's own label on the spool
  purchaseDate       DateTime?
  purchasePriceCents Int?
  totalGrams         Float         @default(1000)
  remainingGrams     Float         @default(1000)
  wasteGrams         Float         @default(0)
  // IN_STOCK | IN_USE | EMPTY | RETIRED — see SPOOL_STATUSES
  status             String        @default("IN_STOCK")
  printerAssetId     String? // loaded on / compatible with
  receiptId          String?
  expenseId          String?
  notes              String?
  uses               FilamentUse[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([accountId])
  @@index([accountId, status])
}

// Customer -> part -> printer -> filament -> invoice, in one row plus its
// filament uses. Every money figure that can be DERIVED is derived in code
// (src/lib/manufacturing.ts) so it can never drift from its inputs.
model PrintJob {
  id                      String        @id @default(cuid())
  accountId               String
  jobNumber               String // "JOB-001" — unique per account
  partName                String
  partNumber              String?
  description             String?
  customerId              String?
  printerAssetId          String?
  quantity                Int           @default(1)
  failedCount             Int           @default(0)
  printMinutes            Int?
  laborMinutes            Int?
  machineRateCentsPerHour Int?
  laborRateCentsPerHour   Int?
  packagingCostCents      Int?
  shippingCostCents       Int?
  otherCostCents          Int?
  salePriceCents          Int?
  invoiceId               String? // revenue lives on the invoice; never double counted
  // QUEUED | PRINTING | DONE | SHIPPED | CANCELLED — see PRINT_JOB_STATUSES
  status                  String        @default("QUEUED")
  startedAt               DateTime?
  completedAt             DateTime?
  notes                   String?
  filamentUses            FilamentUse[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@unique([accountId, jobNumber])
  @@index([accountId])
  @@index([accountId, status])
  @@index([customerId])
  @@index([printerAssetId])
}

// Grams pulled from a spool for a job — decrements the spool's remaining.
model FilamentUse {
  id         String        @id @default(cuid())
  accountId  String
  printJobId String
  printJob   PrintJob      @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  spoolId    String
  spool      FilamentSpool @relation(fields: [spoolId], references: [id], onDelete: Cascade)
  grams      Float
  wasteGrams Float         @default(0)
  createdAt  DateTime      @default(now())

  @@index([printJobId])
  @@index([spoolId])
  @@index([accountId])
}

// ———————————————————————————————————————————————————————————————————————
// V2 remainder — bank transaction matching (SPEC §18)
// ———————————————————————————————————————————————————————————————————————

model BankTransaction {
  id               String   @id @default(cuid())
  accountId        String
  bankName         String?
  importBatchId    String?
  date             DateTime
  description      String
  // Negative = money out, positive = money in. Always as the bank stated it.
  amountCents      Int
  balanceCents     Int?
  // Stable hash of (date, description, amount) so re-importing an overlapping
  // statement can never duplicate a row.
  fingerprint      String
  // UNMATCHED | MATCHED | IGNORED — see BANK_TXN_STATUSES
  status           String   @default("UNMATCHED")
  matchedExpenseId String?
  matchedIncomeId  String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([accountId, fingerprint])
  @@index([accountId, status])
  @@index([accountId, date])
}

// Remembers how a given bank's CSV columns map, so the second import of the
// same statement format asks nothing.
model BankImportProfile {
  id          String   @id @default(cuid())
  accountId   String
  bankName    String
  mappingJson String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, bankName])
  @@index([accountId])
}

// ———————————————————————————————————————————————————————————————————————
// Generalized document storage (SPEC §31) — photos, manuals, warranties,
// paperwork, CAD files, attached to ANY record.
// ———————————————————————————————————————————————————————————————————————

model Document {
  id        String   @id @default(cuid())
  accountId String
  ownerType String // ASSET | CUSTOMER | ANIMAL | PRINT_JOB | INVOICE | EXPENSE
  ownerId   String
  kind      String   @default("DOCUMENT") // see DOCUMENT_KINDS
  title     String
  filePath  String // same storage tiering as receipts (src/lib/storage.ts)
  fileName  String
  mimeType  String
  fileSize  Int
  notes     String?
  createdAt DateTime @default(now())

  @@index([accountId, ownerType, ownerId])
  @@index([accountId])
}

// ———————————————————————————————————————————————————————————————————————
// FR-006 remainder — itemised receipt lines
// ———————————————————————————————————————————————————————————————————————

model ReceiptLine {
  id                 String  @id @default(cuid())
  accountId          String
  receiptId          String
  receipt            Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  sortOrder          Int     @default(0)
  description        String
  quantity           Float   @default(1)
  amountCents        Int
  // Optional per-line category so one receipt can split across categories.
  accountingCategory String?

  @@index([receiptId])
  @@index([accountId])
}

// ———————————————————————————————————————————————————————————————————————
// Dashboard — upcoming bills (SPEC §2)
// A business bill is DECLARED here and shown as upcoming; it is never
// auto-posted to the books. Money leaving the business stays deliberate.
// ———————————————————————————————————————————————————————————————————————

model RecurringBill {
  id                 String   @id @default(cuid())
  accountId          String
  description        String
  amountCents        Int
  division           String
  accountingCategory String
  vendorName         String?
  dayOfMonth         Int      @default(1) // 1–28 so it exists in every month
  active             Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([accountId])
}
